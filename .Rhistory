library(SparseFactor)
load("data.RData")
Mhat <- estCov(ym, 1) ## M matrix
dd <- eigen(Mhat)$values ### eigenvalues
r <- 3
Shat <- as.matrix(eigen(Mhat)$vectors[,1:r]) ## traditional approach
lamvec1 <- 10^seq(-3,-1, length =100)
fit1 <- sparsefa_seq_bic(ym = ym, r = r, lambda = lamvec1)
fit1 <- sparsefa_seq_bic(ym = ym, r = r, lambda = lamvec1)
class(ym)
p <- ncol(ym)
n <- nrow(ym)
Mhat <- estCov(ym, 1)
Qt <- as.matrix(eigen(Mhat)$vectors[,1:r])
lambda = lamvec1
nlam1 <- length(lambda)
bic1 <- rep(0, nlam1)
loss1 <- rep(0, nlam1)
param1 <- rep(0, nlam1)
for(i in 1:nlam1)
{
resi <- sparsefa_seq_Q(Qt = Qt,r = r,lambda = lambda[i])
if(mean(round(abs(resi$Thetaest),5)>0) >0)
{
predi <- predfun(resi,ym)
loss1[i] <- mean((ym - predi)^2)
param1[i] <- sum(round(resi$Thetaest,5)!=0)
bic1[i] <- log(loss1[i]) + param1[i]*log(n*p)/n/p
}
else{break}
}
