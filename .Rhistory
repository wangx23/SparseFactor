source("SparseGroupFM.R")
source("dist.r")
library(truncnorm)
r <- 3
n <- 500
subfun <- function(mm, p)
{
prg <- c(1/6, 1/6, 1/6, 1/4, 1/4)
prg3 <- c(1/6,1/6, 1/6, 1/6, 1/6, 1/6)
nJ <- round(prg*p) ## number of elements in each group
nJ[5] <- nJ[5] + p-sum(nJ)
nJ3 <- round(prg3*p)
nJ3[6] <- nJ3[6] + p-sum(nJ3)
group_vec <- rep(1:5, nJ)
group_vec3 <- rep(1:6, nJ3)
group <- cbind(group_vec, group_vec, group_vec3)
rr <- 1/3
rrn <- 1-rr
rr3 <- 1/4
rrn3 <- 1-rr3
ind1 <- c(1:round(nJ[1]*rrn),
nJ[1] + 1:round(nJ[2]*rrn),
sum(nJ[1:2]) + 1:nJ[3])
ind2 <- c(round(nJ[1]*rr) + 1:round(nJ[1]*rrn),
nJ[1] +round(nJ[2]*rr)+ 1:round(nJ[2]*rrn),
sum(nJ[1:2]) + round(nJ[3]*rr) + 1:round(nJ[3]*rrn),
sum(nJ[1:3]) + round(nJ[4]*rr) + 1:round(nJ[4]*rrn))
ind3 <- c(nJ3[1] + 1:round(nJ3[2]*rrn3),
sum(nJ3[1:2]) + 1:round(nJ3[3]*rrn3),
sum(nJ3[1:3]) + 1:round(nJ3[4]*rrn3),
sum(nJ3[1:4]) + 1:nJ3[5],
sum(nJ3[1:5])+ 1:nJ3[6])
nnz1 <- length(ind1)
nnz2 <- length(ind2)
nnz3 <- length(ind3)
set.seed(mm + 123456)
aa1 <- rbinom(nnz1, size = 1, prob = 0.5)
aa2 <- rbinom(nnz2, size = 1, prob = 0.5)
aa3 <- rbinom(nnz3, size = 1, prob = 0.5)
Theta <- matrix(0, p, r)
Theta[ind1,1] <- aa1*rtruncnorm(nnz1,a =0.05) + rtruncnorm(nnz1,b =-0.05)*(1-aa1)
Theta[ind2,2] <- aa2*rtruncnorm(nnz2,a =0.05) + rtruncnorm(nnz2,b =-0.05)*(1-aa2)
Theta[ind3,3] <- aa3*rtruncnorm(nnz3,a =0.05) + rtruncnorm(nnz3,b =-0.05)*(1-aa3)
del <-  0.5
eps.tmp <- rnorm(n,0,sqrt(del))
eps <- matrix(rep(eps.tmp,times=p) + rnorm(n*p,0,sqrt(0.5)),n,p)
xm <- matrix(0, n, r)
for(j in 1:r)
{
xm[,j] <- arima.sim(list(order = c(1,0,0),ar = 0.95),n = n)
}
ym <- matrix(0,n, p)
for(j in 1:n)
{
ym[j,] <- Theta %*% xm[j,]
}
ym <- ym +eps
Mhat <- estCov(ym, 1)
Shat <- as.matrix(eigen(Mhat)$vectors[,1:r])
dd <- eigen(Mhat)$values
dist0 <- dist_space(Theta, Shat)
result <- c(dist0, rep(0,3*(r+1)))
###  no group ###
lamvec1 <- 10^seq(-3,-1, length =100)
fit1 <- sparsefa_seq_bic(ym = ym, r = r, lambda = lamvec1)
Qest1 <- fit1$Thetaest
dist1 <- dist_space(Theta, Qest1)
fvalue1 <- unlist(lapply(1:r, function(x){f1Calculation(Qest1[,x], Theta[,x])}))
result <- rbind(result,
c(dist1, fvalue1, colSums(Qest1==0)))
lamvec2 <- 10^seq(-3,-1, length =100)
fit2 <- SparseGroupFM_bic2(ym = ym, r = r, group = group,
lamvec1 = lamvec2,lamvec2=lamvec2)
Qest2 <- fit2$fit$Qest
dist2 <- dist_space(Theta,Qest2)
fvalue2 <- unlist(lapply(1:r, function(x){f1Calculation(Qest2[,x], Theta[,x])}))
result <- rbind(result,
c(dist2, fvalue2,colSums(Qest2==0)))
result <- as.data.frame(result)
result <- cbind(c("eigen","sparse","sparsegroup"),
result)
colnames(result) <- c("method","dist",
paste(rep(c("FN","FP","f1_q"),r), rep(1:r, each = 3),sep=""),
"nzero1","nzero2","nzero3")
rownames(result) <- NULL
return(result)
}
subfun1 <- function(mm)
{
subfun(mm, 60)
}
subfun2 <- function(mm)
{
subfun(mm, 120)
}
subfun3 <- function(mm)
{
subfun(mm, 200)
}
temp <- subfun(1)
temp <- subfun(1, 50)
?forceSymmetric
??forceSymmetric
