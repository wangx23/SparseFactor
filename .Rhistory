rrn <- 1-rr
nnz1 <- sum(round(nJ[1:3]*rrn))
nnz2 <- sum(round(nJ[1:4]*rrn))
nnz3 <- sum(round(nJ[2:4])) + nJ[5]
aa1 <- rbinom(nnz1, size = 1, prob = 0.5)
aa2 <- rbinom(nnz2, size = 1, prob = 0.5)
aa3 <- rbinom(nnz3, size = 1, prob = 0.5)
ind1 <- c(1:round(nJ[1]*rrn),
nJ[1] + 1:round(nJ[2]*rrn),
sum(nJ[1:2]) + 1:round(nJ[3]*rrn))
ind2 <- c(round(nJ[1]*rr) + 1:round(nJ[1]*rrn),
nJ[1] +round(nJ[2]*rr)+ 1:round(nJ[2]*rrn),
sum(nJ[1:2]) + round(nJ[3]*rr) + 1:round(nJ[3]*rrn),
sum(nJ[1:3]) + round(nJ[4]*rr) + 1:round(nJ[4]*rrn))
ind3 <- c(nJ[1] + 1:nJ[2], sum(nJ[1:2]) + 1:nJ[3],
sum(nJ[1:3]) + 1:nJ[4],sum(nJ[1:4]) + 1:nJ[5])
Theta <- matrix(0, p, r)
Theta[ind1,1] <- aa1*rtruncnorm(nnz1,a =0.05) + rtruncnorm(nnz1,b =-0.05)*(1-aa1)
Theta[ind2,2] <- aa2*rtruncnorm(nnz2,a =0.05) + rtruncnorm(nnz2,b =-0.05)*(1-aa2)
Theta[ind3,3] <- aa3*rtruncnorm(nnz3,a =0.05) + rtruncnorm(nnz3,b =-0.05)*(1-aa3)
