library(devtools)
install_github("wangx23/SparseFactor")
library(SparseFactor)
load("data.RData")
Mhat <- estCov(ym, 1) ## M matrix
dd <- eigen(Mhat)$values ### eigenvalues
r <- 3
Shat <- as.matrix(eigen(Mhat)$vectors[,1:r]) ## traditional approach
### sparse factor model
lamvec1 <- 10^seq(-3,-1, length =100)
fit1 <- sparsefa_seq_bic(ym = ym, r = r, lambda = lamvec1)
Qest1 <- fit1$fit$Qest ### estimated loadings
fest1 <- estfactor(obj = fit1, ym = ym) ## estimated factor process
### sparse group factor model
lamvec2 <- 10^seq(-3,-1, length =100)
fit2 <- SparseGroupFM_bic2(ym = ym, r = r, group = group,
lamvec1 = lamvec2,lamvec2=lamvec2)
Qest2 <- fit2$fit$Qest ### estimated loadings
fest2 <- estfactor(obj = fit2, ym = ym) ## estimated factor process
?SparseGroupFM
?sparsefa_seq_bic
?SparseGroupFM_bic2
